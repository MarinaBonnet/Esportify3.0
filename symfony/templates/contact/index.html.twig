{% extends 'base.html.twig' %}

{% block title %}Contact - Esportify{% endblock %}

{% block body %}

<section class="auth">
    <div class="auth__form">

        <h1 class="form__title">Contact</h1>

        <p class="form__intro">
            Une question, une suggestion ou un problème ? Contactez l'équipe Esportify.
        </p>

        {% for message in app.flashes('success') %}
        <div class="alert alert--success">
            {{ message }}
        </div>
        {% endfor %}

        {{ form_start(form, {
        attr: {
        class: 'form'
        }
        }) }}

        <div class="form__group">
            {{ form_label(form.nom, 'Nom') }}
            {{ form_widget(form.nom) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="form__group">
            {{ form_label(form.email, 'Adresse e-mail') }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form__group">
            {{ form_label(form.sujet, 'Sujet') }}
            {{ form_widget(form.sujet) }}
            {{ form_errors(form.sujet) }}
        </div>

        <div class="form__group">
            {{ form_label(form.message, 'Message') }}
            {{ form_widget(form.message) }}
            {{ form_errors(form.message) }}
        </div>

        <div class="form__actions">
            <button type="submit" class="btn btn--primary">
                Envoyer
            </button>
        </div>

        {{ form_end(form) }}

    </div>

</section>

{% endblock %}