{% extends 'base.html.twig' %}

{% block title %}Modifier un événement{% endblock %}

{% block body %}

<section class="auth">

    <div class="auth__form">

        <h1 class="form__title">Modifier un événement</h1>

        {{ include('evenement/_form.html.twig', {
        button_label: 'Enregistrer les modifications'
        }) }}

        <div class="form__actions">
            {{ include('evenement/_delete_form.html.twig') }}
        </div>

        <div class="auth__links">
            <a href="{{ path('app_evenement_index') }}">
                Retour à la liste des événements
            </a>
        </div>

    </div>

</section>

{% endblock %}