<form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}"
    onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cet événement ?');">

    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">

    <button type="submit" class="btn btn--danger">
        Supprimer l'événement
    </button>


</form>