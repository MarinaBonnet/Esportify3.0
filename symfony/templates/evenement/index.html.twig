{% extends 'base.html.twig' %}

{% block title %}Tous les événements{% endblock %}

{% block body %}

<section class="events-page">

    <header class="events-page__header">
        <h1>Tous les événements</h1>

        <p>
            Retrouvez les événements e-sport validés par l'équipe Esportify.
        </p>
    </header>

    <div class="events-page__filters">
        <label for="sort-events">Trier les événements à venir :</label>

        <select id="sort-events">
            <option value="date">Date</option>
            <option value="places">Nombre de joueurs</option>
            <option value="organisateur">Organisateur</option>
        </select>
    </div>

    {% if is_granted('ROLE_ORGANISATEUR') %}
    <a href="{{ path('app_evenement_new') }}" class="btn-primary">
        Créer un événement
    </a>
    {% endif %}

    <section class="events-section events-section--upcoming">
        <h2>Événements à venir</h2>

        <div id="events-results" class="events-page__grid">
            {% for evenement in aVenir %}
            {% include 'evenement/_card.html.twig' with { evenement: evenement } %}
            {% else %}
            <p class="events-page__empty">Aucun événement à venir.</p>
            {% endfor %}
        </div>
    </section>

    <section class="events-section events-section--live">
        <h2>Événements en cours</h2>

        <div class="events-page__grid">
            {% for evenement in enCours %}
            {% include 'evenement/_card.html.twig' with { evenement: evenement } %}
            {% else %}
            <p class="events-page__empty">Aucun événement en cours.</p>
            {% endfor %}
        </div>
    </section>

    <section class="events-section events-section--finished">
        <h2>Événements terminés</h2>

        <div class="events-page__grid">
            {% for evenement in termines %}
            {% include 'evenement/_card.html.twig' with { evenement: evenement } %}
            {% else %}
            <p class="events-page__empty">Aucun événement terminé.</p>
            {% endfor %}
        </div>
    </section>

    <section class="events-ranking">
        <h2>Top joueurs</h2>

        {% for score in topScores %}
        <div class="events-ranking__item">
            <strong>
                #{{ loop.index }} {{ score.user.pseudo }}
            </strong>

            <span>{{ score.value }} pts</span>
        </div>
        {% endfor %}
    </section>

</section>

<div class="event-modal" id="event-modal" aria-hidden="true">

    <div class="event-modal__overlay" data-close-modal></div>

    <div class="event-modal__content">

        <button class="event-modal__close" type="button" data-close-modal>
            &times;
        </button>

        <div id="event-modal-body">
            Chargement...
        </div>

    </div>

</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script type="module" src="{{ asset('js/main.js') }}" defer></script>

{% endblock %}