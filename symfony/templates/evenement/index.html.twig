{% extends 'base.html.twig' %}

{% block title %}Tous les événements{% endblock %}

{% block body %}

<section class="events-page">

    <header class="events-page__header">

        <h1>
            Tous les événements
        </h1>

        <p>
            Retrouvez les événements e-sport validés par l'équipe Esportify.
        </p>

    </header>

    <div class="events-page__filters">

        <label for="sort-events">
            Trier par :
        </label>

        <select id="sort-events">
            <option value="date">Date</option>
            <option value="places">Nombre de joueurs</option>
            <option value="organisateur">
                Organisateur
            </option>
        </select>

    </div>

    {% if is_granted('ROLE_ORGANISATEUR') %}
    <a href="{{ path('app_evenement_new') }}" class="btn-primary">
        Créer un événement
    </a>
    {% endif %}

    <section id="events-results" class="events-page__grid">

        {% for evenement in evenements %}

        <article class="event-card">

            <h2>
                {{ evenement.titre }}
            </h2>

            <p>
                <i class="fa-solid fa-users"></i>
                {{ evenement.nbPlaces }} joueurs
            </p>

            <p>
                Début :
                {{ evenement.dateStart|date('d/m/Y H:i') }}
            </p>

            <p>
                Fin :
                {{ evenement.dateEnd|date('d/m/Y H:i') }}
            </p>

            <a href="{{ path(
                        'app_evenement_show',
                        { id: evenement.id }
                    ) }}" class="btn-secondary">
                Voir les détails
            </a>

        </article>

        {% else %}

        <p>
            Aucun événement disponible.
        </p>

        {% endfor %}

    </section>

    <section class="events-ranking">

        <h2>
            Top joueurs
        </h2>

        {% for score in topScores %}

        <div class="events-ranking__item">

            <strong>
                #{{ loop.index }}
                {{ score.user.pseudo }}
            </strong>

            <span>
                {{ score.value }} pts
            </span>

        </div>

        {% endfor %}

    </section>

</section>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/events-filter.js') }}" defer></script>
{% endblock %}