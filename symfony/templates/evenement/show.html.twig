{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }}{% endblock %}

{% block body %}

<section class="event-detail">

    <h1>{{ evenement.titre }}</h1>

    {% set image = evenement.images|first %}

    {% if image %}
    <img src="{{ asset(image.url) }}" alt="{{ image.alt ?? evenement.titre }}">
    {% endif %}

    <p>
        {{ evenement.description }}
    </p>

    <ul>
        <li>Jeu : {{ evenement.jeu.nom }}</li>
        <li>Organisateur : {{ evenement.organisateur.pseudo }}</li>
        <li>Places : {{ evenement.nbPlaces }}</li>
        <li>Début : {{ evenement.dateStart|date('d/m/Y H:i') }}</li>
        <li>Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}</li>
        <li>Statut : {{ evenement.status }}</li>
    </ul>

    <div class="event-actions">

        <a href="{{ path('app_evenement_index') }}">
            Retour aux événements
        </a>

        <a href="{{ path('app_evenement_classement', {
            id: evenement.id
        }) }}">
            Voir le classement
        </a>

        {% if is_granted('ROLE_JOUEUR') %}

        {% set now = "now"|date("U") %}
        {% set end = evenement.dateEnd|date("U") %}

        {% if end > now %}

        <a href="{{ path('app_evenement_participer', {
            id: evenement.id
        }) }}">
            Participer
        </a>

        <a href="{{ path('app_evenement_favori', {
            id: evenement.id
        }) }}">
            Ajouter aux favoris
        </a>

        {% else %}

        <p>
            Cet événement est terminé.
        </p>

        {% endif %}

        {% endif %}

        {% if is_granted('ROLE_ADMIN')
        or app.user == evenement.organisateur
        %}
        {% if evenement.dateStart > date()
        or is_granted('ROLE_ADMIN')
        %}
        <a href="{{ path('app_evenement_edit', {
                    id: evenement.id
                }) }}">
            Modifier
        </a>
        {% endif %}

        {{ include('evenement/_delete_form.html.twig') }}
        {% endif %}

    </div>

</section>

{% endblock %}