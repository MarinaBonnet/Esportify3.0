{% extends 'base.html.twig' %}

{% block title %}
{{ evenement.titre }}
{% endblock %}

{% block body %}

<section class="event-detail">

    <h1>
        {{ evenement.titre }}
    </h1>

    {% set image = evenement.images|first %}

    {% if image %}
    <img src="{{ asset(image.url) }}" alt="{{ image.alt ?? evenement.titre }}" class="event-detail__image">
    {% endif %}

    <p class="event-detail__description">
        {{ evenement.description }}
    </p>

    <ul class="event-detail__infos">

        <li>
            Jeu :
            {{ evenement.jeu.nom }}
        </li>

        <li>
            Organisateur :
            {{ evenement.organisateur.pseudo }}
        </li>

        <li>
            Places :
            {{ evenement.nbPlaces }}
        </li>

        <li>
            Début :
            {{ evenement.dateStart|date('d/m/Y H:i') }}
        </li>

        <li>
            Fin :
            {{ evenement.dateEnd|date('d/m/Y H:i') }}
        </li>

        <li>
            Statut :
            {{ evenement.status }}
        </li>

    </ul>

    <div class="event-detail__actions">

        <a href="{{ path('app_evenement_index') }}" class="btn-secondary">
            Retour
        </a>

        <a href="{{ path('app_evenement_classement', {
            id: evenement.id
        }) }}" class="btn-secondary">
            Classement
        </a>

        {% if is_granted('ROLE_JOUEUR') %}

        {% set now = "now"|date("U") %}
        {% set end = evenement.dateEnd|date("U") %}

        {% if end > now %}

        <a href="{{ path('app_evenement_participer', {
                    id: evenement.id
                }) }}" class="btn-primary">
            Participer
        </a>

        <a href="{{ path('app_evenement_favori', {
                    id: evenement.id
                }) }}" class="btn-secondary">
            Favori
        </a>

        {% endif %}

        {% endif %}

        {% if is_granted('ROLE_ADMIN')
        or app.user == evenement.organisateur %}

        {% if evenement.dateStart > date()
        or is_granted('ROLE_ADMIN') %}

        <a href="{{ path('app_evenement_edit', {
                    id: evenement.id
                }) }}" class="btn-secondary">
            Modifier
        </a>

        {% endif %}

        {{ include('evenement/_delete_form.html.twig') }}

        {% endif %}

    </div>

</section>

{% endblock %}