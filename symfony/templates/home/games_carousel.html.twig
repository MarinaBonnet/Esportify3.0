<section class="games-carousel">

    <h2 class="games-carousel__title">
        Jeux disponibles
    </h2>

    <div class="games-carousel__container js-carousel">

        <button type="button" class="games-carousel__button js-carousel-prev">
            <i class="fa-solid fa-backward"></i>
        </button>

        <div class="games-carousel__track js-carousel-track">

            {% for jeu in jeux %}
            <article class="games-carousel__item">

                {% if jeu.logo %}
                <img class="games-carousel__logo" src="{{ asset(jeu.logo) }}" alt="{{ jeu.nom }}">
                {% endif %}

                <div class="games-carousel__content">
                    <h3 class="games-carousel__name">
                        {{ jeu.nom }}
                    </h3>

                    {% if jeu.editeur %}
                    <p class="games-carousel__editor">
                        {{ jeu.editeur }}
                    </p>
                    {% endif %}
                </div>

            </article>
            {% endfor %}

        </div>

        <button type="button" class="games-carousel__button js-carousel-next">
            <i class="fa-solid fa-forward"></i>
        </button>

    </div>

</section>