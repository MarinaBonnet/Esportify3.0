{% extends 'base.html.twig' %}

{% block title %}Accueil - Esportify{% endblock %}

{% block body %}
<h1>Bienvenue sur Esportify</h1>

<section>
    <h2>Présentation</h2>
    <p>
        Esportify est une plateforme dédiée à l'organisation et à la participation
        à des événements e-sport.
    </p>
</section>

<section>
    <h2>Événements à venir et en cours</h2>

    {% if evenements is empty %}
    <p>Aucun événement validé pour le moment.</p>
    {% else %}
    <ul>
        {% for evenement in evenements %}
        <li>
            <strong>{{ evenement.titre }}</strong><br>
            Jeu : {{ evenement.jeu.nom }}<br>
            Places : {{ evenement.nbPlaces }}<br>
            Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>
            Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
{% endblock %}