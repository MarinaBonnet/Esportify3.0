{% extends 'base.html.twig' %}

{% block title %}Accueil - Esportify{% endblock %}

{% block body %}
<h1>Bienvenue sur Esportify</h1>

<section>
    <h2>Présentation</h2>
    <p>
        Esportify est une plateforme dédiée à l'organisation et à la participation
        à des événements e-sport.
    </p>
</section>

<section>
    <h2>Événements à venir et en cours</h2>

    {% if evenements is empty %}
    <p>Aucun événement validé pour le moment.</p>
    {% else %}
    <ul>
        {% for evenement in evenements %}
        <li>
            <strong>{{ evenement.titre }}</strong><br>
            Jeu : {{ evenement.jeu.nom }}<br>
            Places : {{ evenement.nbPlaces }}<br>
            Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>
            Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}
            <br>
            {% if app.user %}
            {% if favorisUtilisateur[evenement.id] is defined %}
            <a href="{{ path('app_evenement_retirer_favori', { id: evenement.id }) }}">
                Retirer des favoris
            </a><br>
            {% else %}
            <a href="{{ path('app_evenement_favori', { id: evenement.id }) }}">
                Ajouter aux favoris
            </a>
            {% endif %}
            {% endif %}

            {% if app.user %}
            {% if participationsUtilisateur[evenement.id] is defined %}
            {% set participation = participationsUtilisateur[evenement.id] %}

            {% if participation.status == 'en_attente' %}
            <span>Demande en attente</span>
            {% elseif participation.status == 'accepte' %}
            <span>Inscription acceptée</span>
            {% elseif participation.status == 'refuse' %}
            <span>Inscription refusée</span>
            {% endif %}
            {% else %}
            <a href="{{ path('app_evenement_participer', { id: evenement.id }) }}">
                Participer
            </a>
            {% endif %}
            {% else %}
            <a href="{{ path('app_login') }}">
                Connectez-vous pour participer
            </a>
            {% endif %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
{% endblock %}