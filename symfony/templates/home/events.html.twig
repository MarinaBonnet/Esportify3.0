<section class="events">

    <h2 class="events__title">
        Événements à venir
    </h2>

    {% if evenements is empty %}

    <p class="events__empty">
        Aucun événement disponible.
    </p>

    {% else %}

    <div class="events__grid">

        {% for evenement in evenements %}

        <article class="event-card">

            {% set image = evenement.images|first %}

            {% if image %}
            <img class="event-card__image" src="{{ asset(image.url) }}" alt="{{ image.alt ?? evenement.titre }}">
            {% endif %}

            <div class="event-card__content">

                <h3 class="event-card__title">
                    {{ evenement.titre }}
                </h3>

                <p class="event-card__date">
                    <i class="fa-solid fa-calendar-days"></i>
                    {{ evenement.dateStart|date('d/m/Y H:i') }}
                </p>

                <p class="event-card__date">
                    <i class="fa-solid fa-clock"></i>
                    {{ evenement.dateEnd|date('d/m/Y H:i') }}
                </p>

                <p class="event-card__players">
                    <i class="fa-solid fa-users"></i>
                    {{ evenement.nbPlaces }} joueurs
                </p>

                <a class="event-card__link" href="{{ path('app_evenement_show', {
                                id: evenement.id
                            }) }}">
                    Voir l'événement
                </a>

            </div>

        </article>

        {% endfor %}

    </div>

    {% endif %}

</section>