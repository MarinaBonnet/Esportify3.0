{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}

<section class="profile-page">

    <div class="profile-page__container">

        <div class="profile-card">
            <div class="profile-card__avatar">
                <img src="{{ app.user.avatar }}" alt="Avatar de {{ app.user.pseudo }}">
            </div>

            <h1 class="profile-card__title">Mon profil</h1>

            <p class="profile-card__subtitle">
                Modifiez vos informations personnelles et votre avatar.
            </p>
        </div>

        {% for message in app.flashes('success') %}
        <div class="alert alert--success">
            {{ message }}
        </div>
        {% endfor %}

        {{ form_start(form, {
        attr: {
        class: 'form profile-page__form'
        }
        }) }}

        <div class="form__group">
            {{ form_label(form.pseudo, 'Pseudo') }}
            {{ form_widget(form.pseudo) }}
            {{ form_errors(form.pseudo) }}
        </div>

        <div class="form__group">
            {{ form_label(form.email, 'Adresse e-mail') }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form__group">
            {{ form_label(form.avatar, 'Avatar') }}
            {{ form_widget(form.avatar) }}
            {{ form_errors(form.avatar) }}
        </div>

        <div class="form__actions">
            <button type="submit" class="btn btn--primary">
                Enregistrer
            </button>
        </div>

        {{ form_end(form) }}

        <div class="profile-links">
            <a href="{{ path('app_profile_password') }}" class="btn btn--secondary">
                Changer mon mot de passe
            </a>
        </div>

    </div>

</section>

{% endblock %}