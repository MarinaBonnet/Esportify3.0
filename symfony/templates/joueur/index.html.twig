{% extends 'base.html.twig' %}

{% block title %}Dashboard Joueur{% endblock %}

{% block body %} <h1>Dashboard Joueur</h1>

{% if app.user.avatar %}
<img src="{{ app.user.avatar }}" alt="Avatar de {{ app.user.pseudo }}" width="80">
{% endif %}
{% if app.user %}
<p>Bienvenue {{ app.user.pseudo }}</p>
{% else %}
<p>Utilisateur non connecté</p>
{% endif %}
<h2>Mes favoris</h2>

{% if favoris is empty %}
<p>Aucun événement ajouté aux favoris.</p>
{% else %}
<ul>
    {% for favori in favoris %}
    <li>
        <strong>{{ favori.evenement.titre }}</strong><br>
        Jeu : {{ favori.evenement.jeu.nom }}<br>
        Début : {{ favori.evenement.dateStart|date('d/m/Y H:i') }}<br>
        Places : {{ favori.evenement.nbPlaces }}
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Mes participations</h2>

{% if participations is empty %}
<p>Aucune participation pour le moment.</p>
{% else %}
<ul>
    {% for participation in participations %}
    <li>
        <strong>{{ participation.evenement.titre }}</strong><br>
        Jeu : {{ participation.evenement.jeu.nom }}<br>
        Statut : {{ participation.status }}<br>
        Début : {{ participation.evenement.dateStart|date('d/m/Y H:i') }}<br>

        {% set now = "now"|date("U") %}
        {% set startTime = participation.evenement.dateStart|date("U") %}

        {% if participation.status == 'accepte'
        and participation.evenement.startedAt is not null
        and now >= startTime
        %}
        <a href="{{ path('app_evenement_room', {
            id: participation.evenement.id
        }) }}">
            Rejoindre la room
        </a>
        {% elseif participation.status == 'accepte' %}
        <small>En attente du démarrage de l'événement.</small>
        {% endif %}
        {% if participation.status != 'refuse' %}
        <a href="{{ path('app_evenement_desinscrire', {
        id: participation.evenement.id
        }) }}">
            Se désinscrire
        </a>
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Mes scores</h2>

{% if scores is empty %}
<p>Aucun score enregistré pour le moment.</p>
{% else %}
<ul>
    {% for score in scores %}
    <li>
        <strong>{{ score.evenement.titre }}</strong><br>
        Score : {{ score.value }}<br>
        Enregistré le :
        {{ score.createdAt|date('d/m/Y H:i') }}
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Mes événements proposés</h2>

{% if evenementsProposes is empty %}
<p>Aucun événement proposé.</p>
{% else %}
<ul>
    {% for evenement in evenementsProposes %}
    <li>
        <strong>{{ evenement.titre }}</strong><br>
        Jeu : {{ evenement.jeu.nom }}<br>
        Statut : {{ evenement.status }}<br>
        Début : {{ evenement.dateStart|date('d/m/Y H:i') }}
    </li>
    {% endfor %}
</ul>
{% endif %}
<ul>
    <li>Voir les événements disponibles</li>
    <li>Mon profil</li>
</ul>


{% endblock %}