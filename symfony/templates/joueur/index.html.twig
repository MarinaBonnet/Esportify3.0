{% extends 'base.html.twig' %}

{% block title %}Dashboard Joueur{% endblock %}

{% block body %} <h1>Dashboard Joueur</h1>

```
{% if app.user %}
<p>Bienvenue {{ app.user.email }}</p>
{% else %}
<p>Utilisateur non connecté</p>
{% endif %}
<h2>Mes favoris</h2>

{% if favoris is empty %}
<p>Aucun événement ajouté aux favoris.</p>
{% else %}
<ul>
    {% for favori in favoris %}
    <li>
        {{ favori.evenement.titre }} -
        {{ favori.evenement.jeu.nom }} -
        {{ favori.evenement.dateStart|date('d/m/Y H:i') }}
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Mes participations</h2>
{% if participations is empty %}
<p>Aucune participation pour le moment.</p>
{% else %}
<ul>
    {% for participation in participations %}
    <li>
        {{ participation.evenement.titre }} -
        {{ participation.evenement.jeu.nom }} -
        {{ participation.status }}
    </li>
    {% endfor %}
</ul>
{% endif %}
<h2>Mes scores</h2>
{% if scores is empty %}
<p>Aucun score enregistré pour le moment.</p>
{% else %}
<ul>
    {% for score in scores %}
    <li>
        {{ score.evenement.titre }} -
        Score : {{ score.value }} -
        {{ score.createdAt|date('d/m/Y H:i') }}
    </li>
    {% endfor %}
</ul>
{% endif %}
<ul>
    <li>Voir les événements disponibles</li>



    <li>Mon profil</li>
</ul>
```

{% endblock %}