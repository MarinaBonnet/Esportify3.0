{% extends 'base.html.twig' %}

{% block title %}Dashboard Joueur{% endblock %}

{% block body %}

<section class="dashboard dashboard--player">

    <header class="dashboard__header">
        <div>
            <p class="dashboard__eyebrow">Espace joueur</p>

            {% if app.user.avatar %}
            <img src="{{ app.user.avatar }}" alt="Avatar de {{ app.user.pseudo }}" class="dashboard__avatar"
                loading="lazy">
            {% endif %}

            <h1>Bonjour {{ app.user.pseudo }} 👋</h1>
            <p>Bienvenue sur ton espace joueur.</p>
            <p>Inscrit le {{ app.user.createdAt|date('d/m/Y') }}</p>
        </div>
    </header>

    <section class="dashboard__actions">
        <a href="{{ path('app_evenement_index') }}" class="btn btn--secondary">Voir les événements disponibles</a>
        <a href="{{ path('app_profile') }}" class="btn btn--secondary">Mon profil</a>
        <a href="{{ path('app_evenement_new') }}" class="btn btn--primary">Créer un événement</a>
    </section>

    <div class="dashboard__grid">

        <section class="dashboard-card">
            <h2>Mes participations</h2>

            {% if participations is empty %}
            <p>Aucune participation pour le moment.</p>
            {% else %}
            <ul>
                {% for participation in participations %}
                {% set evenement = participation.evenement %}
                {% set now = "now"|date("U", "Europe/Paris") %}
                {% set start = evenement.dateStart|date("U", "Europe/Paris") %}
                {% set end = evenement.dateEnd|date("U", "Europe/Paris") %}

                <li>
                    <strong>{{ evenement.titre }}</strong><br>
                    Jeu : {{ evenement.jeu.nom }}<br>
                    Statut inscription : {{ participation.status }}<br>
                    Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>
                    Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}<br>

                    {% if end <= now %} <span class="event-card__label event-card__label--danger">
                        Terminé / archivé
                        </span><br>

                        <a href="{{ path('app_evenement_classement', { id: evenement.id }) }}">
                            Voir le classement
                        </a>

                        {% elseif participation.status == 'refuse' %}
                        <span class="event-card__label event-card__label--danger">
                            Inscription refusée
                        </span>

                        {% elseif participation.status == 'accepte' and evenement.startedAt is not null and now >= start
                        %}
                        <a href="{{ path('app_evenement_room', { id: evenement.id }) }}">
                            Rejoindre la room
                        </a>

                        {% elseif participation.status == 'accepte' %}
                        <span class="event-card__label event-card__label--info">
                            En attente du démarrage
                        </span><br>

                        {% if start > now %}
                        <a href="{{ path('app_evenement_desinscrire', { id: evenement.id }) }}">
                            Se désinscrire
                        </a>
                        {% endif %}
                        {% endif %}
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </section>

        <section class="dashboard-card">
            <h2>Mes favoris</h2>

            {% if favoris is empty %}
            <p>Aucun événement ajouté aux favoris.</p>
            {% else %}
            <ul>
                {% for favori in favoris %}
                {% set evenement = favori.evenement %}
                {% set now = "now"|date("U", "Europe/Paris") %}
                {% set end = evenement.dateEnd|date("U", "Europe/Paris") %}

                <li>
                    <strong>{{ evenement.titre }}</strong><br>
                    Jeu : {{ evenement.jeu.nom }}<br>
                    Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>
                    Places : {{ evenement.nbPlaces }}<br>

                    {% if end <= now %} <span class="event-card__label event-card__label--danger">
                        Terminé / archivé
                        </span><br>
                        {% endif %}

                        <a href="{{ path('app_evenement_show', { id: evenement.id }) }}">
                            Voir
                        </a><br>

                        {% if end > now %}
                        <a href="{{ path('app_evenement_retirer_favori', { id: evenement.id }) }}">
                            Retirer des favoris
                        </a>
                        {% endif %}
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </section>

        <section class="dashboard-card">
            <h2>Mes événements proposés</h2>

            {% if evenementsProposes is empty %}
            <p>Aucun événement proposé.</p>
            {% else %}
            <ul>
                {% for evenement in evenementsProposes %}
                {% set now = "now"|date("U", "Europe/Paris") %}
                {% set start = evenement.dateStart|date("U", "Europe/Paris") %}
                {% set end = evenement.dateEnd|date("U", "Europe/Paris") %}
                {% set startLimit = start - 1800 %}

                <li>
                    <strong>{{ evenement.titre }}</strong><br>
                    Jeu : {{ evenement.jeu.nom }}<br>
                    Statut : {{ evenement.status }}<br>
                    Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>

                    {% if end <= now %} <span class="event-card__label event-card__label--danger">
                        Terminé / archivé
                        </span><br>

                        <a href="{{ path('app_evenement_classement', { id: evenement.id }) }}">
                            Voir le classement
                        </a>

                        {% else %}

                        {% if evenement.status == 'valide' %}
                        <span class="event-card__label event-card__label--success">
                            Validé
                        </span><br>
                        {% elseif evenement.status == 'refuse' %}
                        <span class="event-card__label event-card__label--danger">
                            Non validé
                        </span><br>
                        {% if evenement.motifRefus %}
                        <div class="event-card__notice event-card__notice--danger">
                            <strong>Motif du refus :</strong><br>
                            {{ evenement.motifRefus }}
                        </div>
                        {% endif %}
                        {% else %}
                        <span class="event-card__label event-card__label--warning">
                            En attente admin
                        </span><br>
                        {% endif %}

                        {% if start > now and evenement.startedAt is null %}
                        <a href="{{ path('app_evenement_edit', { id: evenement.id }) }}">
                            Modifier
                        </a><br>
                        {% endif %}

                        {% if evenement.status == 'valide' %}
                        {% if evenement.startedAt is not null %}
                        <a href="{{ path('app_evenement_room', { id: evenement.id }) }}">
                            Accéder à la room
                        </a><br>
                        {% else %}
                        <small>En attente de démarrage par un organisateur.</small>
                        {% endif %}
                        {% endif %}

                        {% endif %}
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </section>

        <section class="dashboard-card">
            <h2>Mes scores</h2>

            {% if scores is empty %}
            <p>Aucun score enregistré pour le moment.</p>
            {% else %}
            <ul>
                {% for score in scores %}
                <li>
                    <strong>{{ score.evenement.titre }}</strong><br>
                    Score : {{ score.value }}<br>
                    Enregistré le : {{ score.createdAt|date('d/m/Y H:i') }}
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </section>

    </div>
</section>

{% endblock %}