{% extends 'base.html.twig' %}

{% block title %}Dashboard Joueur{% endblock %}

{% block body %}

<h1>Dashboard Joueur</h1>

<section>
    {% if app.user.avatar %}
    <img src="{{ app.user.avatar }}" alt="Avatar de {{ app.user.pseudo }}" width="80">
    {% endif %}

    <p>Bienvenue {{ app.user.pseudo }}</p>
</section>

<section>
    <h2>Actions rapides</h2>

    <ul>
        <li>
            <a href="{{ path('app_evenement_index') }}">
                Voir les événements disponibles
            </a>
        </li>

        <li>
            <a href="{{ path('app_profile') }}">
                Mon profil
            </a>
        </li>


        <li>
            <a href="{{ path('app_evenement_new') }}">
                Créer un événement
            </a>
        </li>

    </ul>
</section>

<section>
    <h2>Mes participations</h2>

    {% if participations is empty %}
    <p>Aucune participation pour le moment.</p>
    {% else %}
    <ul>
        {% for participation in participations %}
        <li>
            <strong>{{ participation.evenement.titre }}</strong><br>
            Jeu : {{ participation.evenement.jeu.nom }}<br>
            Statut : {{ participation.status }}<br>
            Début : {{ participation.evenement.dateStart|date('d/m/Y H:i') }}<br>
            Fin : {{ participation.evenement.dateEnd|date('d/m/Y H:i') }}

            {% set now = "now"|date("U") %}
            {% set startTime = participation.evenement.dateStart|date("U") %}
            {% set endTime = participation.evenement.dateEnd|date("U") %}

            {% if endTime <= now %} <br><small>Événement terminé.</small><br>

                <a href="{{ path('app_evenement_classement', {
        id: participation.evenement.id
    }) }}">
                    Voir le classement
                </a>

                {% else %}

                {% if participation.status == 'accepte'
                and participation.evenement.startedAt is not null
                and now >= startTime
                %}
                <a href="{{ path('app_evenement_room', {
            id: participation.evenement.id
        }) }}">
                    Rejoindre la room
                </a><br>

                {% elseif participation.status == 'accepte' %}
                <small>En attente du démarrage de l'événement.</small><br>
                {% endif %}

                {% if participation.status != 'refuse' and startTime > now %}
                <a href="{{ path('app_evenement_desinscrire', {
            id: participation.evenement.id
        }) }}">
                    Se désinscrire
                </a>
                {% endif %}

                {% endif %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>

<section>
    <h2>Mes favoris</h2>

    {% if favoris is empty %}
    <p>Aucun événement ajouté aux favoris.</p>
    {% else %}
    <ul>
        {% for favori in favoris %}
        <li>
            <strong>{{ favori.evenement.titre }}</strong><br>
            Jeu : {{ favori.evenement.jeu.nom }}<br>
            Début : {{ favori.evenement.dateStart|date('d/m/Y H:i') }}<br>
            Places : {{ favori.evenement.nbPlaces }}<br>

            <a href="{{ path('app_evenement_retirer_favori', {
                        id: favori.evenement.id
                    }) }}">
                Retirer des favoris
            </a>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>

<section>
    <h2>Mes événements proposés</h2>

    {% if evenementsProposes is empty %}
    <p>Aucun événement proposé.</p>
    {% else %}
    <ul>
        {% for evenement in evenementsProposes %}
        <li>
            <strong>{{ evenement.titre }}</strong><br>
            Jeu : {{ evenement.jeu.nom }}<br>
            Statut : {{ evenement.status }}<br>
            Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>

            {% set now = "now"|date("U") %}
            {% set start = evenement.dateStart|date("U") %}
            {% set end = evenement.dateEnd|date("U") %}

            {% if end <= now %} <small>Événement terminé.</small>

                <a href="{{ path('app_evenement_classement', {
        id: evenement.id
    }) }}">
                    Voir le classement
                </a>

                {% elseif start > now and evenement.startedAt is null %}
                <a href="{{ path('app_evenement_edit', {
        id: evenement.id
    }) }}">
                    Modifier
                </a>
                {% if evenement.status == 'valide' %}
                <a href="{{ path('app_evenement_participer', {
            id: evenement.id
        }) }}">
                    Participer
                </a>
                {% endif %}

                {% elseif evenement.startedAt is not null %}
                <small>Événement démarré.</small>

                {% else %}
                <small>Modification impossible après le début.</small>
                {% endif %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>

<section>
    <h2>Mes scores</h2>

    {% if scores is empty %}
    <p>Aucun score enregistré pour le moment.</p>
    {% else %}
    <ul>
        {% for score in scores %}
        <li>
            <strong>{{ score.evenement.titre }}</strong><br>
            Score : {{ score.value }}<br>
            Enregistré le :
            {{ score.createdAt|date('d/m/Y H:i') }}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>

{% endblock %}