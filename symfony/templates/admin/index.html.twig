{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}

<section class="dashboard dashboard--admin">

    <header class="dashboard__header">
        <div>
            <p class="dashboard__eyebrow">Espace administrateur</p>
            <h1>Bienvenue {{ app.user.pseudo ?? app.user.email }} 👋</h1>
            <p>Gérez les utilisateurs, les événements, les messages et la newsletter.</p>
        </div>
    </header>

    <section class="dashboard__actions">
        <a href="{{ path('app_evenement_index') }}" class="btn btn--secondary">Voir les événements</a>
        <a href="{{ path('app_organisateur') }}" class="btn btn--secondary">Espace organisateur</a>
        <a href="{{ path('app_joueur') }}" class="btn btn--secondary">Espace joueur</a>
    </section>

    <section class="dashboard__stats">
        <article class="dashboard-card">
            <span class="dashboard-card__label">Utilisateurs</span>
            <strong class="dashboard-card__value">{{ nbUsers }}</strong>
        </article>

        <article class="dashboard-card">
            <span class="dashboard-card__label">Événements</span>
            <strong class="dashboard-card__value">{{ nbEvenements }}</strong>
        </article>

        <article class="dashboard-card">
            <span class="dashboard-card__label">Jeux</span>
            <strong class="dashboard-card__value">{{ nbJeux }}</strong>
        </article>

        <article class="dashboard-card">
            <span class="dashboard-card__label">Participations</span>
            <strong class="dashboard-card__value">{{ nbParticipations }}</strong>
        </article>

        <article class="dashboard-card">
            <span class="dashboard-card__label">Newsletters</span>
            <strong class="dashboard-card__value">{{ nbNewsletters }}</strong>
        </article>
    </section>

    <section class="dashboard__section">
        <h2>Événements en attente</h2>

        {% if evenementsEnAttente is empty %}
        <div class="empty-state">
            <p>Aucun événement en attente.</p>
        </div>
        {% else %}
        <div class="event-grid">
            {% for evenement in evenementsEnAttente %}
            {% set now = "now"|date("U", "Europe/Paris") %}
            {% set end = evenement.dateEnd|date("U", "Europe/Paris") %}

            <article class="event-card">
                <div class="event-card__header">
                    <h3 class="event-card__title">{{ evenement.titre }}</h3>

                    <span class="event-card__status event-card__status--pending">
                        En attente
                    </span>
                </div>

                <ul class="event-card__infos">
                    <li>Organisateur : {{ evenement.organisateur.pseudo ?? evenement.organisateur.email }}</li>
                    <li>Début : {{ evenement.dateStart|date('d/m/Y H:i') }}</li>
                    <li>Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}</li>
                </ul>

                <div class="event-card__actions">
                    {% if end <= now %} <span class="event-card__label event-card__label--danger">
                        Terminé / archivé
                        </span>

                        <a href="{{ path('app_evenement_classement', { id: evenement.id }) }}"
                            class="btn btn--secondary">
                            Classement
                        </a>
                        {% else %}
                        <a href="{{ path('app_admin_evenement_valider', { id: evenement.id }) }}"
                            class="btn btn--success">
                            Valider
                        </a>

                        <form method="post" action="{{ path('app_admin_evenement_refuser', { id: evenement.id }) }}"
                            class="event-card__refuse-form">

                            <textarea name="motifRefus" rows="3" placeholder="Motif du refus..."></textarea>

                            <button type="submit" class="btn btn--danger">
                                Refuser
                            </button>
                        </form>
                        {% endif %}
                </div>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <section class="dashboard__section">
        <h2>Événements validés</h2>

        {% set hasValidEvents = false %}

        <div class="event-grid">
            {% for evenement in evenementsTraites %}
            {% if evenement.status == 'valide' %}
            {% set hasValidEvents = true %}
            {% set now = "now"|date("U", "Europe/Paris") %}
            {% set end = evenement.dateEnd|date("U", "Europe/Paris") %}

            <article class="event-card">
                <div class="event-card__header">
                    <h3 class="event-card__title">{{ evenement.titre }}</h3>

                    <span class="event-card__status event-card__status--valid">
                        Validé
                    </span>
                </div>

                <ul class="event-card__infos">
                    <li>Organisateur : {{ evenement.organisateur.pseudo ?? evenement.organisateur.email }}</li>
                    <li>Début : {{ evenement.dateStart|date('d/m/Y H:i') }}</li>
                    <li>Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}</li>
                </ul>

                <div class="event-card__actions">
                    {% if end <= now %} <span class="event-card__label event-card__label--danger">
                        Terminé / archivé
                        </span>

                        <a href="{{ path('app_evenement_classement', { id: evenement.id }) }}"
                            class="btn btn--secondary">
                            Classement
                        </a>
                        {% else %}
                        <a href="{{ path('app_admin_evenement_refuser', { id: evenement.id }) }}"
                            class="btn btn--danger">
                            Suspendre
                        </a>
                        {% endif %}
                </div>
            </article>
            {% endif %}
            {% endfor %}
        </div>

        {% if not hasValidEvents %}
        <div class="empty-state">
            <p>Aucun événement validé.</p>
        </div>
        {% endif %}
    </section>

    <section class="dashboard__section">
        <h2>Événements refusés</h2>

        {% set hasRefusedEvents = false %}

        <div class="event-grid">
            {% for evenement in evenementsTraites %}
            {% if evenement.status == 'refuse' %}
            {% set hasRefusedEvents = true %}
            {% set now = "now"|date("U", "Europe/Paris") %}
            {% set end = evenement.dateEnd|date("U", "Europe/Paris") %}

            <article class="event-card">
                <div class="event-card__header">
                    <h3 class="event-card__title">{{ evenement.titre }}</h3>

                    <span class="event-card__label event-card__label--danger">
                        Refusé
                    </span>
                </div>

                <ul class="event-card__infos">
                    <li>Organisateur : {{ evenement.organisateur.pseudo ?? evenement.organisateur.email }}</li>
                    <li>Début : {{ evenement.dateStart|date('d/m/Y H:i') }}</li>
                    <li>Fin : {{ evenement.dateEnd|date('d/m/Y H:i') }}</li>
                </ul>

                {% if evenement.motifRefus %}
                <div class="event-card__notice event-card__notice--danger">
                    <strong>Motif du refus :</strong><br>
                    {{ evenement.motifRefus }}
                </div>
                {% endif %}

                <div class="event-card__actions">
                    {% if end <= now %} <span class="event-card__label event-card__label--danger">
                        Terminé / archivé
                        </span>
                        {% else %}
                        <a href="{{ path('app_admin_evenement_valider', { id: evenement.id }) }}"
                            class="btn btn--success">
                            Valider
                        </a>
                        {% endif %}

                        <form method="post" action="{{ path('app_evenement_delete', { id: evenement.id }) }}"
                            onsubmit="return confirm('Supprimer définitivement cet événement ?');">

                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">

                            <button type="submit" class="btn btn--danger">
                                Supprimer
                            </button>
                        </form>
                </div>
            </article>
            {% endif %}
            {% endfor %}
        </div>

        {% if not hasRefusedEvents %}
        <div class="empty-state">
            <p>Aucun événement refusé.</p>
        </div>
        {% endif %}
    </section>

    <section class="dashboard__section">
        <h2>Gestion des utilisateurs</h2>

        {% if users is empty %}
        <div class="empty-state">
            <p>Aucun utilisateur enregistré.</p>
        </div>
        {% else %}
        <div class="request-list">
            {% for user in users %}
            <article class="request-card">
                <p>
                    <strong>{{ user.pseudo ?? 'Utilisateur sans pseudo' }}</strong><br>
                    {{ user.email }}<br>

                    {% if 'ROLE_ADMIN' in user.roles %}
                    <span class="event-card__label event-card__label--success">
                        Administrateur
                    </span>
                    {% elseif 'ROLE_ORGANISATEUR' in user.roles %}
                    <span class="event-card__label event-card__label--info">
                        Organisateur
                    </span>
                    {% else %}
                    <span class="event-card__label event-card__label--warning">
                        Joueur
                    </span>
                    {% endif %}
                </p>

                <div class="request-card__actions">
                    {% if 'ROLE_ADMIN' in user.roles %}
                    <span class="event-card__label event-card__label--success">
                        Compte protégé
                    </span>
                    {% elseif 'ROLE_ORGANISATEUR' in user.roles %}
                    <a href="{{ path('app_admin_user_remove_organisateur', { id: user.id }) }}" class="btn btn--danger">
                        Retirer organisateur
                    </a>
                    {% else %}
                    <a href="{{ path('app_admin_user_promote_organisateur', { id: user.id }) }}"
                        class="btn btn--primary">
                        Promouvoir organisateur
                    </a>
                    {% endif %}
                </div>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <section class="dashboard__section">
        <h2>Messages reçus</h2>

        {% if contacts is empty %}
        <div class="empty-state">
            <p>Aucun message.</p>
        </div>
        {% else %}
        <div class="request-list">
            {% for contact in contacts %}
            <article class="request-card">
                <p>
                    <strong>{{ contact.nom }}</strong><br>
                    {{ contact.email }}<br>
                    {{ contact.sujet }}
                </p>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <section class="dashboard__section">
        <h2>Abonnés Newsletter</h2>

        {% if newsletters is empty %}
        <div class="empty-state">
            <p>Aucun abonné.</p>
        </div>
        {% else %}
        <div class="request-list">
            {% for newsletter in newsletters %}
            <article class="request-card">
                <p>
                    <strong>{{ newsletter.email }}</strong><br>
                    Inscrit le {{ newsletter.createdAt|date('d/m/Y H:i') }}
                </p>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

</section>

{% endblock %}