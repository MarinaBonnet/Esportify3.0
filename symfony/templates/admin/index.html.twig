{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}

<h1>Dashboard Administrateur</h1>

<p>Bienvenue {{ app.user.email }}</p>

<h2>Statistiques</h2>

<ul>
    <li>Utilisateurs : {{ nbUsers }}</li>
    <li>Événements : {{ nbEvenements }}</li>
    <li>Jeux : {{ nbJeux }}</li>
    <li>Participations : {{ nbParticipations }}</li>
    <li>Newsletters : {{ nbNewsletters }}</li>
</ul>

<h2>Événements en attente</h2>

{% if evenementsEnAttente is empty %}
<p>Aucun événement en attente.</p>
{% else %}
<ul>
    {% for evenement in evenementsEnAttente %}
    <li>
        <strong>{{ evenement.titre }}</strong><br>

        Organisateur :
        {{ evenement.organisateur.email }}<br>

        Début :
        {{ evenement.dateStart|date('d/m/Y H:i') }}<br>

        <a href="{{ path('app_admin_evenement_valider', {
                    id: evenement.id
                }) }}">
            Valider
        </a>

        <a href="{{ path('app_admin_evenement_refuser', {
                    id: evenement.id
                }) }}">
            Refuser
        </a>
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Tous les événements</h2>

{% if evenementsTraites is empty %}
<p>Aucun événement.</p>
{% else %}
<ul>
    {% for evenement in evenementsTraites %}
    <li>
        <strong>{{ evenement.titre }}</strong><br>
        Organisateur : {{ evenement.organisateur.pseudo }}<br>
        Statut : {{ evenement.status }}<br>
        Début : {{ evenement.dateStart|date('d/m/Y H:i') }}<br>

        {% if evenement.status == 'en_attente' %}
        <a href="{{ path('app_admin_evenement_valider', {
                        id: evenement.id
                    }) }}">
            Valider
        </a>

        <a href="{{ path('app_admin_evenement_refuser', {
                        id: evenement.id
                    }) }}">
            Refuser
        </a>
        {% elseif evenement.status == 'valide' %}
        <a href="{{ path('app_admin_evenement_refuser', {
                        id: evenement.id
                    }) }}">
            Suspendre
        </a>
        {% elseif evenement.status == 'refuse' %}
        <a href="{{ path('app_admin_evenement_valider', {
                        id: evenement.id
                    }) }}">
            Revalider
        </a>
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Gestion des utilisateurs</h2>

<ul>
    {% for user in users %}
    <li>

        <strong>{{ user.pseudo }}</strong>
        -
        {{ user.email }}
        -
        {{ user.roles|join(', ') }}

        <br>

        {% if 'ROLE_ADMIN' not in user.roles %}

        {% if 'ROLE_ORGANISATEUR' not in user.roles %}

        <a href="{{ path(
                        'app_admin_user_promote_organisateur',
                        { id: user.id }
                    ) }}">
            Promouvoir organisateur
        </a>

        {% else %}

        <a href="{{ path(
                        'app_admin_user_remove_organisateur',
                        { id: user.id }
                    ) }}">
            Retirer organisateur
        </a>

        {% endif %}

        {% endif %}

    </li>
    {% endfor %}
</ul>

<h2>Messages reçus</h2>

{% if contacts is empty %}
<p>Aucun message.</p>
{% else %}
<ul>
    {% for contact in contacts %}
    <li>
        <strong>{{ contact.nom }}</strong>
        - {{ contact.email }}
        - {{ contact.sujet }}
    </li>
    {% endfor %}
</ul>
{% endif %}

<h2>Abonnés Newsletter</h2>

{% if newsletters is empty %}
<p>Aucun abonné.</p>
{% else %}
<ul>
    {% for newsletter in newsletters %}
    <li>
        {{ newsletter.email }}
        -
        {{ newsletter.createdAt|date('d/m/Y H:i') }}
    </li>
    {% endfor %}
</ul>
{% endif %}





{% endblock %}