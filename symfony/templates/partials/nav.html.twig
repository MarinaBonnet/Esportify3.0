<nav class="main-nav">

    <a class="main-nav__logo" href="{{ path('app_home') }}">
        <img src="{{ asset('uploads/logo-esportify.png') }}" alt="Esportify">
    </a>

    <a href="{{ path('app_home') }}">
        Accueil
    </a>

    <a href="{{ path('app_evenement_index') }}">
        Événements
    </a>

    <a href="{{ path('app_contact') }}">
        Contact
    </a>

    {% if app.user %}

    <a href="
        {% if is_granted('ROLE_ADMIN') %}
            {{ path('app_admin') }}
        {% elseif is_granted('ROLE_ORGANISATEUR') %}
            {{ path('app_organisateur') }}
        {% else %}
            {{ path('app_joueur') }}
        {% endif %}
        ">
        Mon espace
    </a>

    <a href="{{ path('app_logout') }}">
        Déconnexion
    </a>

    {% else %}

    <a href="{{ path('app_register') }}">
        Inscription
    </a>

    <a href="{{ path('app_login') }}" class="btn btn--primary">
        Connexion
    </a>

    {% endif %}

</nav>